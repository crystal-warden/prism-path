{
  "format": "prismpath.core/1",
  "fields": {
    "classifier_version": "int min=3 max=3",
    "tool": "category",
    "path_scope": "category",
    "path_in_toolchain": "bool",
    "path_control": "bool",
    "path_glob": "bool",
    "path_traversal": "bool",
    "path_symlink": "bool",
    "command_class": "category",
    "kill_by_pattern": "bool",
    "git_op": "category",
    "net_dest": "category",
    "proc_class": "category",
    "remote_class": "category"
  },
  "rules": [
    {"target": "refuse_104",
     "when": ["or", ["cmp", "git_op", "==", ["str", "unknown"]],
                    ["cmp", "path_scope", "==", ["str", "unknown"]]]},
    {"target": "refuse_105", "when": ["truthy", "kill_by_pattern"]},
    {"target": "refuse_106",
     "when": ["or", ["cmp", "command_class", "==", ["str", "network"]],
                    ["cmp", "git_op", "==", ["str", "network"]]]},
    {"target": "refuse_130",
     "when": ["or", ["in", "net_dest", [["str", "allowed_host"], ["str", "other"], ["str", "unknown"]]],
                    ["and", ["cmp", "tool", "==", ["str", "connect"]], ["cmp", "net_dest", "==", ["str", "none"]]]]},
    {"target": "refuse_128",
     "when": ["and", ["or", ["in", "tool", [["str", "write_file"], ["str", "delete_path"]]], ["cmp", "command_class", "==", ["str", "mutating"]], ["in", "git_op", [["str", "local_write"], ["str", "mutating"]]]], ["truthy", "path_control"]]},
    {"target": "refuse_107",
     "when": ["and", ["or", ["in", "tool", [["str", "write_file"], ["str", "delete_path"]]],
                    ["cmp", "command_class", "==", ["str", "mutating"]]],
                     ["truthy", "path_in_toolchain"]]},
    {"target": "refuse_108",
     "when": ["and", ["or", ["in", "tool", [["str", "write_file"], ["str", "delete_path"]]],
                    ["cmp", "command_class", "==", ["str", "mutating"]]],
                     ["truthy", "path_glob"]]},
    {"target": "refuse_109",
     "when": ["and", ["or", ["in", "tool", [["str", "write_file"], ["str", "delete_path"]]],
                    ["cmp", "command_class", "==", ["str", "mutating"]]],
                     ["truthy", "path_traversal"]]},
    {"target": "refuse_110",
     "when": ["and", ["or", ["in", "tool", [["str", "write_file"], ["str", "delete_path"]]],
                    ["cmp", "command_class", "==", ["str", "mutating"]]],
                     ["truthy", "path_symlink"]]},
    {"target": "refuse_111", "when": ["cmp", "path_scope", "==", ["str", "outside"]]},
    {"target": "refuse_112", "when": ["cmp", "git_op", "==", ["str", "mutating"]]},
    {"target": "escalate_125", "when": ["cmp", "command_class", "==", ["str", "mutating"]]},
    {"target": "escalate_124",
     "when": ["or", ["cmp", "tool", "==", ["str", "unknown"]],
                    ["cmp", "command_class", "==", ["str", "unknown"]]]},
    {"target": "allow",
     "when": ["and", ["cmp", "git_op", "==", ["str", "push"]],
                     ["cmp", "remote_class", "==", ["str", "allowed"]]]},
    {"target": "escalate_113", "when": ["cmp", "git_op", "==", ["str", "push"]]},
    {"target": "allow",
     "when": ["and", ["cmp", "tool", "==", ["str", "connect"]], ["cmp", "net_dest", "==", ["str", "model_api"]]]},
    {"target": "allow",
     "when": ["and", ["in", "tool", [["str", "list_dir"], ["str", "read_file"], ["str", "write_file"], ["str", "delete_path"]]],
                     ["cmp", "path_scope", "==", ["str", "workspace"]]]},
    {"target": "allow",
     "when": ["and", ["cmp", "tool", "==", ["str", "run_command"]],
                     ["cmp", "command_class", "==", ["str", "read_only"]],
                     ["in", "path_scope", [["str", "none"], ["str", "workspace"]]]]},
    {"target": "allow",
     "when": ["and", ["in", "git_op", [["str", "local_read"], ["str", "local_write"]]],
                     ["in", "path_scope", [["str", "none"], ["str", "workspace"]]]]}
  ]
}
