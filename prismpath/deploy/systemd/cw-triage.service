[Unit]
Description=PrismPath SOC triage — one cycle against the configured SIEM (siem.py port)
Documentation=file:///home/cwadmin/cwprojects/prismpath/adapters/soc/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/cwprojects/prismpath/adapters/soc
# EDIT the environment for your deployment before enabling. SIEM_KIND selects the source
# (wazuh | elastic | ndjson | splunk); TLS verification is ON by default — point SIEM_CA_CERT
# at your CA, or set SIEM_VERIFY_TLS=0 only for self-signed lab indexers.
Environment=SIEM_KIND=wazuh
Environment=WAZUH_MIN_LEVEL=7
Environment=SPRINT_LEDGER=1
#Environment=SIEM_URL=https://127.0.0.1:9200
#Environment=SIEM_USER=admin
#Environment=SIEM_PASSWORD=change-me
#Environment=SIEM_CA_CERT=%h/wazuh-ca.pem
#Environment=SOC_STATE_DIR=%h/cw-staging
#Environment=PRISMPATH_LLM_ENDPOINT=http://127.0.0.1:8888/v1/chat/completions
#Environment=PRISMPATH_LLM_MODEL=gemma4
ExecStart=/usr/bin/env python3 %h/cwprojects/prismpath/adapters/soc/wazuh_triage_agent.py run
Nice=10
IOSchedulingClass=idle
