[Unit]
Description=PrismPath Flow-Ledger — upgrade pending proofs to full Bitcoin attestation
Documentation=file:///home/cwadmin/cwprojects/prismpath/prismpath/SPEC_ledger_opentimestamps.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# EDIT --out (proof store dir) and --label to match cw-ledger-anchor.service before enabling.
ExecStart=%h/cwprojects/prismpath/prismpath/deploy/systemd/cw-ledger-run.sh upgrade --out %h/cw-ledger/proofs --label auto
Nice=10
IOSchedulingClass=idle
