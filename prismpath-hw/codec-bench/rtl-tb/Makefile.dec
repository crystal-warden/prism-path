# cocotb tb: the RTL Zeckendorf decoder vs the same reference generated corpus the encoder used.
#   make -f Makefile.dec         the gate: runs the sim, then fails on any cocotb failure
SIM ?= verilator
TOPLEVEL_LANG ?= verilog
VERILOG_SOURCES = $(PWD)/../../rtl/zeck_dec.sv
COCOTB_TOPLEVEL = zeck_dec
COCOTB_TEST_MODULES = test_zeck_dec
TOPLEVEL = $(COCOTB_TOPLEVEL)
MODULE = $(COCOTB_TEST_MODULES)
GATE_NAME = zeck_dec
GATE_EXPECTED = conformance
include ../../rtl-tb/gate.mk
include $(shell cocotb-config --makefiles)/Makefile.sim
