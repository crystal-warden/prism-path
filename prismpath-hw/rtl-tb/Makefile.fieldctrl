# cocotb tb: ppt_field_ctrl (the field front end: profile select, injection, LED reporting).
#   make -f Makefile.fieldctrl   the gate: runs the sim, then fails on any cocotb failure
SIM ?= verilator
TOPLEVEL_LANG ?= verilog
VERILOG_SOURCES = $(PWD)/../rtl/ppt_field_ctrl.sv
COCOTB_TOPLEVEL = ppt_field_ctrl
COCOTB_TEST_MODULES = test_ppt_field_ctrl
TOPLEVEL = $(COCOTB_TOPLEVEL)
MODULE = $(COCOTB_TEST_MODULES)
GATE_NAME = fieldctrl
GATE_EXPECTED = field_ctrl
include gate.mk
include $(shell cocotb-config --makefiles)/Makefile.sim
