# Deployment topology for the demo/cert scripts. Copy to bench.env and source it, or export
# these in your shell. The defaults inside the scripts assume the reference bench layout
# (a jump host fronting the board's point-to-point link); override everything for other benches.
export PPT_JUMP="adminlocal@192.168.4.2"     # ssh jump host in front of the board
export PPT_BOARD="xilinx@10.10.10.2"         # the PYNQ board behind the jump
export PPT_WIN="user@your-vivado-host"       # Windows/Vivado build machine (synthesis only)
export PPT_WINDIR="C:/path/to/finale_stateful_build/vivado/build_overlay_finale"
