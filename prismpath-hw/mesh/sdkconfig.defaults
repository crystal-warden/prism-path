# The node owns UART0 for a clean status/command channel (uart driver), so disable the console and
# all logging on it. ESP-NOW/Wi-Fi are on by default. Target chosen with `idf.py set-target esp32`.
CONFIG_ESP_CONSOLE_UART_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# The Ed25519 checks and the canon/2 reader of the C core need more stack than the 3.5K default main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# One build runs on every ESP32 classic board, the 26 MHz and the 40 MHz crystal alike.
CONFIG_XTAL_FREQ_AUTO=y
# The durable state is kept in NVS part by part on two partitions (partitions.csv): `nvs` for every part and
# `nvs_copy` for the second copy of the install parts (IS10).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
