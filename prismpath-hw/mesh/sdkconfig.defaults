# The node owns UART0 for a clean status/command channel (uart driver), so disable the console and
# all logging on it. ESP-NOW/Wi-Fi are on by default. Target chosen with `idf.py set-target esp32`.
CONFIG_ESP_CONSOLE_UART_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# Ed25519 verify (Monocypher) needs more stack than the 3.5K default main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
